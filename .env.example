# Savo SiteScout Configuration
# ---------------------------------------------
# Database: Default to SQLite for zero-setup local execution, or PostgreSQL+PostGIS via docker-compose
DATABASE_URL=sqlite:///./sitescout.db
# DATABASE_URL=postgresql://savomart:savomart_secret@localhost:5432/savomart_sitescout

# Savomart Internal Live Stores API
SAVO_STORES_API_URL=https://internal-service.savomart.in/bridge/api/store/list?is_operational=True
SAVO_CRON_TOKEN=savo-bridge-cron-secret

# LLM Provider Configuration ('gemini', 'openai', 'local', or 'none')
# Grounded validator ensures all figures in narrative originate from raw metrics
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port Settings
BACKEND_PORT=8000
FRONTEND_PORT=5173
